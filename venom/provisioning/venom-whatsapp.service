[Unit]
Description=Venom WhatsApp bridge — self-hosted Baileys send + incoming forward
Documentation=https://github.com/Hrishikesh2512/FLINT
After=network-online.target nss-lookup.target venom.service
Wants=network-online.target nss-lookup.target

[Service]
Type=simple
User=venom
WorkingDirectory=/opt/venom/whatsapp-service
ExecStart=/usr/bin/node /opt/venom/whatsapp-service/index.js
Restart=always
RestartSec=5

# Bind localhost-only; Venom's Python reaches it on 127.0.0.1:8788.
Environment=WA_HOST=127.0.0.1
Environment=WA_PORT=8788
Environment=WA_STATE_DIR=/var/lib/venom/whatsapp
# Incoming messages are delivered to the local notification hub over loopback
# (VENOM_NOTIFY_URL default: http://127.0.0.1:8789/notify). GEMINI_API_KEY +
# AUTO_REPLY_USER for auto-reply are written by provision.sh.
EnvironmentFile=-/etc/venom/whatsapp.env

StateDirectory=venom

# A WhatsApp Web client is light, but never let it threaten the voice loop.
MemoryHigh=200M
MemoryMax=300M

# Hardening — only reads its own code, writes only /var/lib/venom/whatsapp.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
