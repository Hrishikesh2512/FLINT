[Unit]
Description=Venom — FLINT wearable appliance daemon
Documentation=https://github.com/Hrishikesh2512/FLINT
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/venom/venv/bin/python -m venom
WatchdogSec=90
Restart=always
RestartSec=5
User=venomd
SupplementaryGroups=audio
RuntimeDirectory=venom
ConfigurationDirectory=venom
StateDirectory=venom

# 2 GB Pi: the voice stack (onnxruntime + live session) fits comfortably here,
# and a leak can never take the machine down.
MemoryHigh=450M
MemoryMax=600M

# Hardening — the daemon only reads /proc/asound, probes TCP, and writes /run/venom.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
