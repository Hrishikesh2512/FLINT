<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_blurb"
            android:textColor="@color/dim"
            android:textSize="14sp"
            android:paddingBottom="22dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/your_name"
            android:textColor="@color/her"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/your_name_hint"
            android:textColor="@color/ink"
            android:textColorHint="@color/dim"
            android:background="@drawable/bubble_her"
            android:padding="14dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="18dp"
            android:importantForAutofill="no"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gemini_key"
            android:textColor="@color/her"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gemini_key_hint"
            android:textColor="@color/ink"
            android:textColorHint="@color/dim"
            android:background="@drawable/bubble_her"
            android:padding="14dp"
            android:inputType="textVisiblePassword"
            android:maxLines="3"
            android:importantForAutofill="no"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gemini_key_where"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:paddingTop="6dp"
            android:paddingBottom="20dp"
            android:autoLink="web"/>

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_title"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/pairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dim"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:paddingBottom="12dp"/>

        <Button
            android:id="@+id/copyToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_token"
            style="?attr/materialButtonOutlinedStyle"/>
    </LinearLayout>
</ScrollView>
