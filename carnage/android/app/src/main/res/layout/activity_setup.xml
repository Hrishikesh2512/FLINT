<?xml version="1.0" encoding="utf-8"?>
<!-- Setting up Carnage: the same night sky and glass as the main screen, in
     three cards — who you are and Jarvis's key, what Jarvis listens for, and
     pairing the Pi. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand"
                android:textColor="@color/carnage"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.42"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="@color/ink"
                android:textSize="28sp"
                android:fontFamily="sans-serif-light"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_blurb"
                android:textColor="@color/dim"
                android:textSize="14sp"
                android:layout_marginBottom="18dp"/>

            <!-- ── you, and Jarvis's key ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/your_name"
                    android:textColor="@color/jarvis"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_field"
                    android:hint="@string/your_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/dim"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gemini_key"
                    android:textColor="@color/jarvis"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_field"
                    android:hint="@string/gemini_key_hint"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:maxLines="3"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/dim"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:paddingTop="8dp"
                    android:text="@string/gemini_key_where"
                    android:textColor="@color/dim"
                    android:textColorLink="@color/jarvis"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- ── what Jarvis listens for ───────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_switches"
                    android:textColor="@color/jarvis"
                    android:textSize="12sp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/wake_switch"
                    android:textColor="@color/ink"
                    android:textSize="15sp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/announce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/announce_switch"
                    android:textColor="@color/ink"
                    android:textSize="15sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/brand_button"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"/>

            <!-- ── pairing the Pi ────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pairing_title"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/pairing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_field"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:textColor="@color/dim"
                    android:textIsSelectable="true"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/copyToken"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_pill"
                    android:text="@string/copy_token"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    app:backgroundTint="@null"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
