<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:fontFamily="sans-serif-light"
                android:text="@string/setup_title"
                android:textColor="@color/ink"
                android:textSize="28sp"/>

            <!-- you, and the key -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_field"
                    android:hint="@string/your_name"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/dim"/>

                <EditText
                    android:id="@+id/key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_field"
                    android:hint="@string/gemini_key"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:maxLines="3"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/dim"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:paddingStart="4dp"
                    android:paddingTop="8dp"
                    android:text="@string/gemini_key_where"
                    android:textColor="@color/dim"
                    android:textColorLink="@color/jarvis"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- switches -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/wake_switch"
                    android:textColor="@color/ink"
                    android:textSize="15sp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/announce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/announce_switch"
                    android:textColor="@color/ink"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/shade"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:text="@string/shade"
                    android:textColor="@color/ink"
                    android:textSize="15sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/brand_button"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"/>

            <!-- pairing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/pairing_title"
                    android:textColor="@color/dim"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/pairing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/copyToken"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_pill"
                    android:text="@string/copy_token"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    app:backgroundTint="@null"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
