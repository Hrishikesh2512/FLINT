<?xml version="1.0" encoding="utf-8"?>
<!-- Carnage, the app — and Jarvis, the mind inside it.

     Glass over a night sky: a header card naming her and how she is, the
     conversation in one tall pane of glass, her core (the thing you tap to talk)
     glowing beneath it, and a pill to type into. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- ── header ───────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand"
                    android:textColor="@color/carnage"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.42"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assistant"
                        android:textColor="@color/ink"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-light"/>

                    <View
                        android:id="@+id/alive"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/dot_alive"/>
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/setup"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/glass_pill"
                android:src="@drawable/ic_tune"
                android:contentDescription="@string/settings"/>
        </LinearLayout>

        <!-- ── the conversation ─────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/conversation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:background="@drawable/glass_card">

            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadingEdgeLength="28dp"
                android:requiresFadingEdge="vertical"
                android:padding="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <!-- What the camera shows her, while he shares it in a call. -->
            <TextureView
                android:id="@+id/cameraView"
                android:layout_width="132dp"
                android:layout_height="176dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:contentDescription="@string/camera_view"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- ── Jarvis's core: tap to talk ───────────────────────────────── -->
        <FrameLayout
            android:id="@+id/core"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:clipChildren="false">

            <View
                android:id="@+id/glow"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_glow"/>

            <View
                android:id="@+id/ring"
                android:layout_width="146dp"
                android:layout_height="146dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_ring"/>

            <TextView
                android:id="@+id/mic"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_core"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/talk"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:elevation="10dp"
                android:contentDescription="@string/talk_to_jarvis"/>
        </FrameLayout>

        <TextView
            android:id="@+id/voiceState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tap_to_talk"
            android:textColor="@color/dim"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <!-- ── live video, while a call is on ───────────────────────────── -->
        <LinearLayout
            android:id="@+id/visionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/shareCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_pill"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/camera_on"
                android:textColor="@color/ink"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/shareScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/glass_pill"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/screen_on"
                android:textColor="@color/ink"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- ── what is attached, above the box ──────────────────────────── -->
        <HorizontalScrollView
            android:id="@+id/attachedRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/attached"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- ── type instead ─────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageButton
                android:id="@+id/attach"
                android:layout_width="42dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_attach"
                android:contentDescription="@string/attach"/>

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/hint"
                android:importantForAutofill="no"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/dim"
                android:textSize="15sp"/>

            <ImageButton
                android:id="@+id/send"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/send_button"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/send"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
