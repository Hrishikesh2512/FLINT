<?xml version="1.0" encoding="utf-8"?>
<!-- Jarvis's core, the button you talk to: the blood moon from the widget.
     Muted crimson, darker at the edge, a veil of storm mist across it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="62dp"
                android:centerX="0.46" android:centerY="0.42"
                android:startColor="#FFC9472F" android:centerColor="#FF8E1526"
                android:endColor="#FF2A0509"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="300" android:startColor="#4798C8D2"
                android:centerColor="#1A98C8D2" android:endColor="#0098C8D2"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#40E8203A"/>
        </shape>
    </item>
</layer-list>
