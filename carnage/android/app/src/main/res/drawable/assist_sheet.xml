<?xml version="1.0" encoding="utf-8"?>
<!-- The assistant overlay: the same glass, but solid, to be readable over any
     app — a white page behind see-through glass would swallow the text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#FF0C2029" android:endColor="#FF071318"/>
    <stroke android:width="1dp" android:color="@color/glass_edge"/>
    <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"
        android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
</shape>
