<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Everything she needs a body for. Each one maps to a skill that simply
         stays off if the permission is refused - a denied permission is never
         an error here, it is a capability she honestly reports not having. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- "Call Papa": placed straight through the telephony service. -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <!-- "Alarm for 6:30" in the clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Live voice calls: routing her to the Bluetooth earphone's mic, and
         hearing him while the screen is off. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- "What am I looking at?": one photo from the back camera. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <!-- Sharing his screen into a voice call (Vision.kt), only when he says. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Shield, his store: granted only because both apps are signed by him,
         it hands Jarvis the API token on the phone itself. -->
    <uses-permission android:name="com.hrishikesh.shield.permission.ACCESS"/>

    <!-- Android 11+ hides other apps unless asked for by name: the music apps
         "play X" may hand a search to. -->
    <queries>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/>
        </intent>
        <!-- "Open Instagram": the launchable apps, to find one by name. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
        <!-- The phone's own speech recognizer, which RecognizerProxy hands
             other apps' voice input on to. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <package android:name="com.hrishikesh.shield"/>
        <!-- "Take me home": navigation goes to Google Maps. -->
        <package android:name="com.google.android.apps.maps"/>
        <package android:name="com.google.android.apps.youtube.music"/>
        <package android:name="com.spotify.music"/>
        <package android:name="com.jio.media.jiobeats"/>
        <package android:name="com.gaana"/>
        <package android:name="com.wynk.music"/>
        <package android:name="com.amazon.mp3"/>
        <package android:name="com.google.android.youtube"/>
    </queries>

    <!-- The foreground service is the difference between an app and an
         assistant: without it Android suspends her a few minutes after the
         screen goes off, and the other devices find nothing to sync with. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:name=".CarnageApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Carnage">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share → Jarvis, from any app: a photo, a PDF, some text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="text/plain"/>
                <!-- WhatsApp's "Export chat" with media comes as a zip. -->
                <data android:mimeType="application/zip"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>


        <!-- Jarvis on the home screen. -->
        <receiver
            android:name=".CarnageWidget"
            android:exported="true"
            android:label="@string/assistant">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/carnage_widget"/>
        </receiver>

        <!-- The "Jarvis" quick-settings tile: swipe down, tap, talk. -->
        <service
            android:name=".TalkTile"
            android:exported="true"
            android:icon="@drawable/ic_presence"
            android:label="@string/assistant"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true"/>
        </service>

        <!-- Jarvis as the phone's digital assistant: hold the power button
             over any app and she opens on top of it, able to see the screen.
             All three are needed for Android to offer her in Default apps. -->
        <service
            android:name=".AssistService"
            android:exported="true"
            android:label="@string/assistant"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService"/>
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction"/>
        </service>

        <service
            android:name=".AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"/>

        <service
            android:name=".RecognizerProxy"
            android:exported="true"
            android:label="@string/assistant">
            <intent-filter>
                <action android:name="android.speech.RecognitionService"/>
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognizer"/>
        </service>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <service
            android:name=".CarnageService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone|camera|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A personal assistant that must stay reachable for
                    the user's other devices to sync with and for reminders to
                    fire while the screen is off."/>
        </service>

        <!-- Brings her back after a restart, so "always there" survives a
             reboot rather than lasting until the first one. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- Hands: using his other apps when he asks (Hands.kt). Only ever
             switched on by him, in Settings → Accessibility. -->
        <service
            android:name=".Hands"
            android:exported="true"
            android:label="@string/assistant"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hands"/>
        </service>

        <!-- Reading the notification shade. Optional: she works without it and
             simply has nothing to report when asked what he missed. -->
        <service
            android:name=".ShadeListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- ONNX Runtime (the wake word) ships Microsoft usage telemetry that
             starts itself through this provider. Nothing in Jarvis phones
             home: removed outright. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove"/>
    </application>
</manifest>
